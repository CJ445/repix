APP_ENV=production
LOG_LEVEL=INFO

MAX_UPLOAD_MB=20
MAX_INPUT_WIDTH=6000
MAX_INPUT_HEIGHT=6000

MAX_OUTPUT_WIDTH=10000
MAX_OUTPUT_HEIGHT=10000
MAX_OUTPUT_PIXELS=50000000

JOB_TTL_MINUTES=60
MAX_AI_WORKERS=1
MAX_QUEUE_SIZE=5
AI_THREADS=0
POLL_INTERVAL_MS=1500

UPSCALE_TILE_SIZE=256
UPSCALE_TILE_OVERLAP=16

RATE_LIMIT_PER_MINUTE=10

# Docker resource limits for the backend container (see docker-compose.yml).
# Keep BACKEND_CPUS well below your host's core count so the machine stays responsive.
BACKEND_CPUS=2
BACKEND_MEMORY=4g
